#!/usr/bin/env bash
# install - point this machine at this checkout.
#
#   ./install            do it
#   ./install --check    say what is wrong, change nothing
#
# Everything the harness needs beyond the repo itself is a symlink or a
# capability, and every one of them is absolute: a second machine that clones to
# a different path keeps running whatever the old links point at. That failure is
# silent - `git pull` appears to change nothing, and the panel opens on a
# directory you thought you had left behind - so this resolves every link from
# where this file actually is, and is safe to re-run whenever the checkout moves.
#
# What it does NOT do, because neither belongs in a repo:
#   - MCP servers (~/.claude.json) - they carry project ids and auth
#   - `gh auth login` - interactive

set -eu

REPO=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
BIN="${FM_BIN:-/opt/homebrew/bin}"
SKILLS="$HOME/.claude/skills"
CHECK=0
[ "${1:-}" = "--check" ] && CHECK=1

ok()   { printf '  ok    %s\n' "$*"; }
todo() { printf '  TODO  %s\n' "$*"; }
warn() { printf '  warn  %s\n' "$*"; }

link() { # link <target> <linkname> [label]
  local target=$1 name=$2 label=${3:-$(basename "$2")}
  if [ "$(readlink -f "$name" 2>/dev/null)" = "$(readlink -f "$target")" ]; then
    ok "$label"
    return
  fi
  if [ "$CHECK" = 1 ]; then
    todo "$label -> $target"
    return
  fi
  mkdir -p "$(dirname "$name")"
  ln -sfn "$target" "$name"
  ok "$label -> $target"
}

# A command already on PATH is relinked where it already lives, not duplicated
# into $BIN. These end up split across bin directories on a real machine - fm in
# one, fmp in another - and installing a second copy elsewhere leaves whichever
# PATH finds first winning, which is the same silent-stale-symlink problem this
# script exists to end.
command_link() { # command_link <target> <name>
  local target=$1 name=$2 existing
  existing=$(command -v "$name" 2>/dev/null || true)
  link "$target" "${existing:-$BIN/$name}" "$name"
}

printf 'harness at %s\n\ncommands:\n' "$REPO"
[ -d "$BIN" ] || { warn "$BIN does not exist - set FM_BIN to a directory on your PATH"; exit 1; }
command_link "$REPO/fm2/bin-fm"          fm
command_link "$REPO/fm2/bin-fmp"         fmp
command_link "$REPO/surface/bin-surface" surface

# The Codex CLI ships inside the desktop app rather than as its own command, so
# nothing finds it by default and `fm caps` reports codex: false.
#
# Its helpers have to come too, and that is the part that is easy to miss:
# `codex` resolves them NEXT TO ITSELF, so linking the CLI alone sends it looking
# in $BIN and finding nothing. Without `codex-code-mode-host` a session has no
# shell at all - it prints `Code mode will fail closed` in a startup banner and
# then tries to finish the job through whatever tools remain, which is how a real
# worker ended up asking permission to open TextEdit to read a file.
#
# Only ever supplied when missing. `rg` in particular is commonly installed
# already, and relinking someone's ripgrep to the one inside an app bundle is not
# this script's business.
provide() { # provide <target> <name>
  local target=$1 name=$2
  if command -v "$name" >/dev/null 2>&1; then
    ok "$name (already on PATH)"
    return
  fi
  [ -x "$target" ] || { todo "$name is not on PATH and is not at $target"; return; }
  link "$target" "$BIN/$name" "$name"
}

CODEX_RESOURCES="${CODEX_RESOURCES:-/Applications/ChatGPT.app/Contents/Resources}"
if [ -d "$CODEX_RESOURCES" ]; then
  for helper in codex codex-code-mode-host codex_chronicle rg; do
    provide "$CODEX_RESOURCES/$helper" "$helper"
  done
elif command -v codex >/dev/null 2>&1; then
  ok 'codex (already on PATH)'
else
  todo 'codex is not installed - install the desktop app, or set CODEX_RESOURCES'
fi

# Claude uses file links; Codex uses complete entrypoint folders and references.
# Skills go through the same code fm uses at every launch, so there is one
# implementation and it cannot drift from what a worker actually gets.
printf '\nskills:\n'
if [ "$CHECK" = 1 ]; then
  node -e '
    const { repoSkills, skillsRoot } = await import(process.argv[1] + "/fm2/lib/skills.mjs");
    const { realpathSync, lstatSync } = await import("node:fs");
    const { join } = await import("node:path");
    let stale = 0;
    for (const agent of ["claude"]) {
      for (const [name, target] of repoSkills(process.argv[1])) {
        const link = join(skillsRoot(agent), name, "SKILL.md");
        let cur = null;
        try { if (lstatSync(link).isSymbolicLink()) cur = realpathSync(link); } catch {}
        if (cur !== realpathSync(target)) { console.log(`  TODO  ${agent}:${name} -> ${cur ?? "missing"}`); stale++; }
      }
    }
    console.log(`  ${stale === 0 ? "ok    all" : stale + " stale of"} ${repoSkills(process.argv[1]).length} Claude skill link(s)`);
  ' "$REPO"
  node "$REPO/codex/install.mjs" --check
else
  node -e '
    const { syncSkills, repoSkills } = await import(process.argv[1] + "/fm2/lib/skills.mjs");
    let total = 0;
    for (const agent of ["claude", "codex"]) {
      const fixed = syncSkills({ repo: process.argv[1], agent });
      total += fixed.length;
      for (const n of fixed) console.log(`  ok    ${agent}:${n}`);
    }
    console.log(`  ${repoSkills(process.argv[1]).length} skill(s) for both providers, ${total} relinked`);
  ' "$REPO"
fi

# A Codex session in an untrusted directory stops on a trust prompt and waits,
# and nothing in the harness answers it - Codex owns its own dialogs. Worse, that
# prompt is what gates project-local hooks loading at all, so a session waved
# through by hand still comes up with no Stop hook: it works, it stops, and it
# never reports. Trust is keyed on the git repository ROOT and covers every
# worktree beside it, so one entry covers a whole project.
printf '\ncodex project trust:\n'
node -e '
  const { readFileSync } = await import("node:fs");
  const { homedir } = await import("node:os");
  const { join } = await import("node:path");
  let config = "";
  try { config = readFileSync(join(homedir(), ".codex", "config.toml"), "utf8"); } catch {}
  const repo = process.argv[1];
  const trusted = new RegExp(`^\\[projects\\."${repo.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}"\\]`, "m").test(config);
  if (trusted) console.log(`  ok    ${repo}`);
  else {
    console.log(`  TODO  ${repo} is not trusted by Codex`);
    console.log(`        run codex once there and answer 1, or add to ~/.codex/config.toml:`);
    console.log(`        [projects."${repo}"]`);
    console.log(`        trust_level = "trusted"`);
  }
  if (!/^approval_policy\s*=/m.test(config) || !/^sandbox_mode\s*=/m.test(config)) {
    console.log("  note  no approval_policy/sandbox_mode set: a Codex worker will stop and");
    console.log("        ask a human on its first command outside its workspace, and fm status");
    console.log("        from inside that sandbox reports every task DEAD. See codex/README.md.");
  }
' "$REPO"

printf '\nthis machine can reach:\n'
for cmd in git tmux node gh; do
  if command -v "$cmd" >/dev/null 2>&1; then ok "$cmd"; else todo "$cmd is not installed"; fi
done
if command -v gh >/dev/null 2>&1; then
  if gh auth status >/dev/null 2>&1; then ok 'gh is authenticated'; else todo 'gh auth login'; fi
fi

# The failure that prompted this: a v1 env var still exported in a shell rc,
# pointing at an old checkout. Nothing current reads FM_ROOT, but FM_REPO and
# FM_PROJECTS ARE read, and an export of either silently overrides everything
# this script just did — the links would be right and the panel would still open
# somewhere else.
printf '\nshell config:\n'
stale=0
for rc in "$HOME/.zshrc" "$HOME/.zshenv" "$HOME/.zprofile" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile"; do
  [ -f "$rc" ] || continue
  while IFS= read -r hit; do
    [ -n "$hit" ] || continue
    stale=1
    printf '  TODO  %s: %s\n' "$(basename "$rc")" "$hit"
  done <<EOF
$(grep -nE '^[^#]*\b(FM_ROOT|FM_REPO|FM_PROJECTS|FM_BIN)=' "$rc" 2>/dev/null || true)
EOF
done
if [ "$stale" = 0 ]; then
  ok 'no harness paths pinned in a shell rc'
else
  printf '        FM_ROOT is dead (v1). FM_REPO and FM_PROJECTS override this script —\n'
  printf '        delete them unless you mean them.\n'
fi

printf '\nother machine-local pieces:\n'
if node -e 'const j=JSON.parse(require("fs").readFileSync(process.env.HOME+"/.claude.json","utf8"));process.exit(Object.keys(j.mcpServers||{}).length?0:1)' 2>/dev/null; then
  ok 'a global MCP server is configured in ~/.claude.json'
else
  todo 'no global mcpServers in ~/.claude.json - worktrees inherit nothing project-scoped'
fi
if [ -f "$HOME/.tmux.conf" ]; then
  ok "~/.tmux.conf present ($(grep -cE 'destroy-unattached|base-index' "$HOME/.tmux.conf" 2>/dev/null || echo 0) setting(s) the harness works around)"
else
  ok 'no ~/.tmux.conf - tmux defaults are fine'
fi

printf '\nnot handled here (per machine, never in the repo):\n' 
printf '  - the Software Factory MCP server, in the global mcpServers of ~/.claude.json\n'
printf '  - anything a project needs to build; the harness only launches sessions\n'

printf '\nBoth providers receive controller lifecycle hooks from fm2/supervisor.mjs.\n'
printf 'Start with fmp <project> [--agent codex]; Claude remains the default.\n'
