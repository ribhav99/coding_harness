diff --git a/codex-rs/tui/src/status/limit_countdown_tests.rs b/codex-rs/tui/src/status/limit_countdown_tests.rs
new file mode 100644
index 0000000..3b49045
--- /dev/null
+++ b/codex-rs/tui/src/status/limit_countdown_tests.rs
@@ -0,0 +1,46 @@
+use super::format_limit_reset_countdown;
+
+#[test]
+fn server_timestamp_counts_down_without_usage_events() {
+    let now = 1_800_000_000;
+    let reset = Some(now + 3 * 86_400 + 4 * 3600 + 12 * 60);
+    assert_eq!(
+        format_limit_reset_countdown(reset, now),
+        Some("resets in 3d 4h 12m".to_string())
+    );
+    assert_eq!(
+        format_limit_reset_countdown(reset, now + 60),
+        Some("resets in 3d 4h 11m".to_string())
+    );
+}
+
+#[test]
+fn missing_and_invalid_timestamps_do_not_invent_a_reset() {
+    for reset in [None, Some(0), Some(-1), Some(i64::MAX)] {
+        assert_eq!(
+            format_limit_reset_countdown(reset, /*now*/ 1_800_000_000),
+            None
+        );
+    }
+}
+
+#[test]
+fn near_and_expired_resets_preserve_server_truth() {
+    let now = 1_800_000_000;
+    assert_eq!(
+        format_limit_reset_countdown(Some(now + 1), now),
+        Some("resets in 1m".to_string())
+    );
+    assert_eq!(
+        format_limit_reset_countdown(Some(now + 61), now),
+        Some("resets in 2m".to_string())
+    );
+    assert_eq!(
+        format_limit_reset_countdown(Some(now), now),
+        Some("reset due".to_string())
+    );
+    assert_eq!(
+        format_limit_reset_countdown(Some(now - 60), now),
+        Some("reset due".to_string())
+    );
+}
