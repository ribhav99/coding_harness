diff --git a/codex-rs/tui/src/status/limit_countdown.rs b/codex-rs/tui/src/status/limit_countdown.rs
new file mode 100644
index 0000000..3947935
--- /dev/null
+++ b/codex-rs/tui/src/status/limit_countdown.rs
@@ -0,0 +1,27 @@
+//! Live reset durations for the native footer, using server timestamps only.
+
+pub(crate) fn format_limit_reset_countdown(reset: Option<i64>, now: i64) -> Option<String> {
+    let reset = reset.filter(|reset| *reset > 0)?;
+    chrono::DateTime::<chrono::Utc>::from_timestamp(reset, /*nsecs*/ 0)?;
+    let seconds = reset.saturating_sub(now);
+    if seconds <= 0 {
+        return Some("reset due".to_string());
+    }
+    // Round up so an unexpired window never appears to have already reset.
+    let minutes = seconds / 60 + i64::from(seconds % 60 != 0);
+    let days = minutes / (24 * 60);
+    let hours = minutes / 60 % 24;
+    let minutes = minutes % 60;
+    let duration = if days > 0 {
+        format!("{days}d {hours}h {minutes}m")
+    } else if hours > 0 {
+        format!("{hours}h {minutes}m")
+    } else {
+        format!("{minutes}m")
+    };
+    Some(format!("resets in {duration}"))
+}
+
