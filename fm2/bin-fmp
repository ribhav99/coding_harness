#!/usr/bin/env bash
# fmp - open (or re-attach to) a project's control panel.
#
#   fmp <project> [--agent claude|codex] [--owner]
#                   create/attach the project's tmux session and start firstmate
#   fmp --choose     attach remotely and choose any live session/window/pane
#   fmp             list the projects it can see
#
# One session per project:
#
#   session fm-<project>
#     control   left: firstmate (cwd = the harness repo)   right: a shell in the project
#     workers   ship task panes                            (`fm ship` fills it)
#     reviews   review panes                               (`fm review` fills it)
#
# All three exist from the moment the panel does, empty or not.
#
# firstmate's pane sits in the harness repo to load its controller instructions.
# The launcher supplies absolute lifecycle hooks. The right-hand shell opens in
# the project, which is also what `fm --project` points at.
#
# Unlike the version this replaces there are no per-project homes. fm2 keeps one
# home (~/.fm2) and every task records its own project, so a project is just a
# directory.
#
# Overrides:
#   FM_REPO          the harness checkout
#   FM_PROJECTS      where projects live      (default ~/Desktop/everything)
#   FMP_CLAUDE_CMD   how firstmate is started
#   FMP_CODEX_CMD    how a Codex firstmate is started
#   FMP_NO_ATTACH=1  build the panel and leave it detached, printing its name

set -eu

# Derived from where this script actually is, not written down. A hardcoded path
# is right on exactly one machine, and wrong in a way that is hard to see: a stale
# PATH symlink keeps running an old checkout, so a `git pull` appears to change
# nothing and the panel opens on the directory you thought you had moved away from.
# `readlink -f` resolves the symlink, so FM_REPO is always the checkout this file
# lives in, whichever one that is.
#
# Projects sit beside the harness, which is the convention Ribhav already
# uses: worktrees are siblings, and so is every other checkout.
FMP_SELF=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
FM_REPO="${FM_REPO:-$(dirname "$FMP_SELF")}"
FM_PROJECTS="${FM_PROJECTS:-$(dirname "$FM_REPO")}"
FMP_CLAUDE_CMD="${FMP_CLAUDE_CMD:-claude --dangerously-skip-permissions --effort max}"

die() { printf 'fmp: %s\n' "$*" >&2; exit 1; }

# A project is a git checkout directly under FM_PROJECTS. Worktrees are siblings
# named <repo>-<something>, so they are skipped: they are task scratch, never a
# thing to open a control panel on.
list_projects() {
  [ -d "$FM_PROJECTS" ] || return 0
  for d in "$FM_PROJECTS"/*/; do
    [ -d "$d/.git" ] || continue
    name=$(basename "$d")
    case "$name" in *-pr-*|*-wo-*) continue ;; esac
    printf '  %s\n' "$name"
  done
}

[ -d "$FM_REPO" ] || die "the harness is not at $FM_REPO (set FM_REPO)"
command -v tmux >/dev/null 2>&1 || die "tmux is not installed (brew install tmux)"

# One app-independent remote entrypoint. tmux's own tree shows every live
# session, window, and pane after SSH connects, so mobile clients do not need a
# separately saved host for every project. ignore-size prevents a phone from
# changing the dimensions or active pane seen by an attached iTerm owner.
if [ "${1:-}" = --choose ]; then
  [ "$#" -eq 1 ] || die 'usage: fmp --choose'
  tmux list-sessions >/dev/null 2>&1 || die 'there are no live tmux sessions'
  if [ -n "${TMUX:-}" ]; then
    tmux choose-tree -s
  else
    tmux attach-session -f ignore-size,active-pane \; choose-tree -s
  fi
  exit 0
fi

if [ $# -eq 0 ]; then
  printf 'usage: fmp <project> [--agent claude|codex] [--owner]\n\nprojects:\n'
  list_projects
  exit 0
fi

PROJECT=$1
shift
FMP_AGENT=claude
FMP_AGENT_EXPLICIT=0
FMP_OWNER_EXPLICIT=0
while [ $# -gt 0 ]; do
  case "$1" in
    --agent) [ $# -ge 2 ] || die '--agent needs claude or codex'; FMP_AGENT=$2; FMP_AGENT_EXPLICIT=1; shift 2 ;;
    --owner) FMP_OWNER_EXPLICIT=1; shift ;;
    *) die "unknown option '$1'" ;;
  esac
done
case "$FMP_AGENT" in claude|codex) ;; *) die "unknown agent '$FMP_AGENT' (use claude or codex)" ;; esac
[ "$FMP_OWNER_EXPLICIT" = 0 ] || [ -z "${TMUX:-}" ] || die '--owner must be run outside tmux'
[ "$FMP_OWNER_EXPLICIT" = 0 ] || [ -z "${FMP_NO_ATTACH:-}" ] || die '--owner cannot be combined with FMP_NO_ATTACH'
FMP_CODEX_CMD="${FMP_CODEX_CMD:-node \"$FM_REPO/fm2/supervisor.mjs\" codex}"
case "$PROJECT" in
  ''|*[!A-Za-z0-9._-]*) die "unsafe project name '$PROJECT'" ;;
esac

PROJ_DIR="$FM_PROJECTS/$PROJECT"
if [ ! -d "$PROJ_DIR/.git" ]; then
  printf 'fmp: no git checkout at %s\n\nprojects:\n' "$PROJ_DIR" >&2
  list_projects >&2
  exit 1
fi
PROJ_DIR=$(cd "$PROJ_DIR" && pwd -P)

SES="fm-$PROJECT"

attach() {
  if [ -n "${TMUX:-}" ]; then tmux switch-client -t "$SES"; else tmux attach-session -t "$SES"; fi
}

# An iTerm pane launched by fmp owns the panel it displays. Secondary clients
# (for example Termius on an iPhone or iPad) may attach at the same time, but
# they must not keep the panel alive after its owning iTerm pane closes.
#
# destroy-unattached cannot express that distinction: every attached client is
# equal to tmux, so a phone would prevent the session from becoming unattached.
# The owner therefore destroys its exact session explicitly when its attachment
# returns. Clearing the traps first keeps signals and EXIT from running cleanup
# twice. A secondary fmp attachment never installs this trap.
cleanup_owned_panel() {
  trap - EXIT INT TERM HUP
  tmux kill-session -t "=$SES" >/dev/null 2>&1 || true
}

own_panel() {
  trap cleanup_owned_panel EXIT INT TERM HUP
}

# switch-client returns immediately, so an fmp invoked from inside tmux cannot
# use its shell process as a lifetime owner. Preserve the previous behavior for
# that path: once the switch succeeds, return the session to tmux's configured
# destroy-unattached policy instead of killing the newly selected session.
release_panel_to_tmux_lifecycle() {
  trap - EXIT INT TERM HUP
  tmux set-option -t "=$SES" -u destroy-unattached >/dev/null 2>&1 || true
}

# Already running: go there. Never rebuild a live session - task panes and their
# worktrees live in it.
if tmux has-session -t "=$SES" 2>/dev/null; then
  FMP_HOPS=0
  while [ "$FMP_HOPS" -lt 30 ]; do
    FMP_NEXT=$(tmux show-option -qv -t "$SES" @fm-successor 2>/dev/null || true)
    [ -n "$FMP_NEXT" ] || break
    tmux has-session -t "=$FMP_NEXT" 2>/dev/null || break
    SES=$FMP_NEXT
    FMP_HOPS=$((FMP_HOPS + 1))
  done
  if [ "$FMP_AGENT_EXPLICIT" = 1 ]; then
    FMP_LIVE_AGENT=$(tmux show-option -qv -t "$SES" @fm-agent 2>/dev/null || true)
    if [ "${FMP_LIVE_AGENT:-claude}" != "$FMP_AGENT" ]; then
      exec node "$FM_REPO/fm2/cli.mjs" panel-switch --panel "$SES" --agent "$FMP_AGENT"
    fi
  fi
  # But say so if it was built against a different checkout. A panel outlives the
  # repo it was started from: move the harness, or clone it somewhere else on a
  # second machine, and `fmp` still finds the old session and takes you to panes
  # sitting in the old directory. Nothing is broken and nothing says anything,
  # so a `git pull` looks like it changed nothing at all. This is the one place
  # that can tell, and it costs a warning, not a refusal - the session may hold
  # live work, so it is never rebuilt out from under Ribhav.
  live=$(tmux list-panes -t "$SES:control" -F '#{pane_current_path}' 2>/dev/null | head -1 || true)
  if [ -n "$live" ] && [ "$live" != "$FM_REPO" ]; then
    printf 'fmp: this panel was built from %s, not %s\n' "$live" "$FM_REPO" >&2
    printf '     attaching to it anyway - it may hold live work.\n' >&2
    printf '     to rebuild against this checkout: tmux kill-session -t %s && fmp %s\n' "$SES" "$PROJECT" >&2
  fi
  # A deliberately detached panel (FMP_NO_ATTACH) has no owner yet. Its first
  # external fmp attachment becomes the owner. A session which already has a
  # client is being viewed secondarily unless --owner explicitly adopts it;
  # that flag lets panels created by an older launcher migrate without restart.
  if [ -z "${TMUX:-}" ] && { [ "$FMP_OWNER_EXPLICIT" = 1 ] ||
     [ "$(tmux display-message -p -t "=$SES:" '#{session_attached}' 2>/dev/null || true)" = 0 ]; }; then
    own_panel
  fi
  attach
  exit 0
fi

# ~/.tmux.conf sets destroy-unattached on, which fires the moment a session has
# no client - including the instant `new-session -d` creates one. A session built
# detached is therefore destroyed before its first window exists.
#
# The create and the session's exemption from that rule are one tmux invocation.
# tmux drains a command queue before it looks for unattached sessions, so a
# set-option chained onto the create lands while the session is still safe. Two
# separate invocations lose it in the gap between them.
#
# Taking the exemption off the GLOBAL option instead - which is what this did
# first - is wrong twice over. While it is off, every other detached session
# loses the same protection. And with no tmux server running there is nothing to
# set a global option ON: the call fails, `new-session` then starts a server that
# reads destroy-unattached on straight from ~/.tmux.conf, and the session is gone
# before its second window. That is a cold start, i.e. the first launch after a
# reboot, and it failed with "no server running" from the next command in the
# build.
tmux new-session -d -s "$SES" -n control -c "$FM_REPO" \
  \; set-option -t "$SES" destroy-unattached off

# From here the session is protected by its own setting, not the global one. An
# external fmp invocation blocks in attach-session and can own the panel until
# that client closes. An invocation already inside tmux uses switch-client,
# which returns immediately, so it retains the launcher's prior lifecycle.
if [ -z "${TMUX:-}" ]; then
  own_panel
else
  trap release_panel_to_tmux_lifecycle EXIT INT TERM HUP
fi

# Number from 1 even on a machine whose tmux config does not say so. Every call
# is failure-tolerant; none of it is worth aborting a launch over.
tmux set-option -t "$SES" base-index 1 >/dev/null 2>&1 || true
tmux set-window-option -g pane-base-index 1 >/dev/null 2>&1 || true
if [ "$(tmux list-windows -t "$SES" -F '#{window_index}' 2>/dev/null | head -1)" = 0 ]; then
  tmux move-window -s "$SES:0" -t "$SES:1" >/dev/null 2>&1 || true
fi

# The panel always has all three windows, empty or not. The shape is the point:
# Ribhav looks at the same panel every time, and a tab that only appears once
# there is something in it is a tab you cannot go and check.
#
# An empty tmux window is impossible - it gets a shell. That shell is why this was
# once cut back to control alone: every task split BESIDE it, leaving one stray
# pane in each window forever. `fm` now takes a placeholder shell OVER instead of
# splitting beside it, so the first task replaces it and the window only ever
# holds what it says it does.
#
# Window names are load-bearing: `fm` routes reviews to "reviews" and everything
# else to "workers" by name, so nothing may rename them.
for win in control workers reviews; do
  [ "$win" = control ] || tmux new-window -d -t "$SES" -n "$win" -c "$PROJ_DIR"
  tmux set-window-option -t "$SES:$win" automatic-rename off 2>/dev/null || true
  tmux set-window-option -t "$SES:$win" allow-rename off 2>/dev/null || true
done

# control: firstmate on the left, a project shell on the right.
tmux split-window -h -t "$SES:control" -c "$PROJ_DIR"
tmux set-option -t "$SES" @fm-agent "$FMP_AGENT"
tmux set-environment -t "$SES" FM2_PANEL "$SES"
tmux set-environment -t "$SES" FM2_AGENT "$FMP_AGENT"
tmux set-environment -t "$SES" PATH "$PATH"

LEFT=$(tmux list-panes -t "$SES:control" -F '#{pane_id}' | head -1)
if [ "$FMP_AGENT" = codex ]; then
  tmux send-keys -t "$LEFT" "$FMP_CODEX_CMD" C-m
else
  if [ "$FMP_CLAUDE_CMD" = 'claude --dangerously-skip-permissions --effort max' ]; then
    tmux send-keys -t "$LEFT" "node \"$FM_REPO/fm2/supervisor.mjs\" claude" C-m
  else
    tmux send-keys -t "$LEFT" "$FMP_CLAUDE_CMD" C-m
  fi
fi

tmux select-window -t "$SES:control"
tmux select-pane -t "$LEFT"

# A build with nothing to attach to keeps its own protection, so the panel is
# still there to switch to later. Without this the trap would hand it straight
# back to the global rule and destroy everything just built.
if [ -n "${FMP_NO_ATTACH:-}" ]; then
  trap - EXIT INT TERM HUP
  printf '%s\n' "$SES"
  exit 0
fi

# The owner trap destroys the exact panel after attach returns. It deliberately
# does not rely on the session becoming completely unattached.
attach
